# Cohere - get a key at https://dashboard.cohere.com/api-keys
COHERE_API_KEY=

# Cordon client keys: comma-separated key_id:secret pairs
CORDON_API_KEYS=demo-key:demo-secret

# Qdrant
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=cordon_cache

# Auth
AUTH_WINDOW_SECONDS=60

# Token bucket (per API key)
RATE_LIMIT_CAPACITY=30
RATE_LIMIT_REFILL_PER_SEC=5

# Semantic cache
CACHE_SIMILARITY_THRESHOLD=0.82
CACHE_RETRIEVE_THRESHOLD=0.7
CACHE_RERANK_THRESHOLD=0.45
CACHE_RERANK_CANDIDATES=5
CACHE_TTL_SECONDS=3600
CACHE_MAX_ENTRIES=1000
CACHE_VECTOR_SIZE=1024

# Models
CHAT_MODEL=command-a-plus-05-2026
EMBED_MODEL=embed-v4.0
RERANK_MODEL=rerank-v3.5

# Server
CORDON_HOST=0.0.0.0
CORDON_PORT=8000
